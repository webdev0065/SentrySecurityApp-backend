PORT=3000
NODE_ENV=development
# Local development (unchanged):
DB_USER=postgres
DB_HOST=localhost
DB_NAME=sentry_security
DB_PASSWORD=replace_me
DB_PORT=5432

# Production (Supabase) — set ONLY on the deployed backend, never commit the
# real value. Takes precedence over DB_* when present.
# Use the Supabase SESSION POOLER (port 5432), not the transaction pooler
# (6543): node-postgres uses server-side prepared statements, which the
# transaction pooler cannot guarantee across pooled transactions.
# Get the exact string from: Supabase dashboard -> Project Settings ->
# Database -> Connection string -> Session pooler.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional pool tuning (sensible defaults are built in):
# DB_CONNECT_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000
# Set to 1 to skip the startup connectivity probe (used by the test harness):
# SKIP_DB_PROBE=1
# Set to 1 to force the DB_* settings above and ignore DATABASE_URL. Used by
# the test harness so an ambient Supabase DATABASE_URL cannot leak into tests:
# DB_USE_LOCAL=1

# Optional: comma-separated browser origins to allow. Leave unset for the
# native mobile app (which does not enforce CORS and uses Bearer tokens).
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://portal.example.com

JWT_SECRET=replace_with_a_long_random_secret
SUPERADMIN_PASSWORD=replace_me
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_VERIFY_SERVICE_SID=replace_me
